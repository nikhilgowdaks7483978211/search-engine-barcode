POSTGRES_PASSWORD=change-me
# Google Programmable Search: key from console.cloud.google.com (enable "Custom Search API"),
# engine ID from programmablesearchengine.google.com (set to search the entire web, enable Image search)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# Optional alternative/extra provider: serpapi.com
SERPAPI_KEY=
# Optional paid UPCitemdb key (free trial endpoint is used when empty, ~100 lookups/day)
UPCITEMDB_KEY=
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MIN=20
CACHE_TTL_HOURS=24
